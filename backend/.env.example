PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitness_store

# SMTP for real emails (Brevo / SendGrid SMTP / Mailgun SMTP / Gmail SMTP app password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Fusion Store <no-reply@yourdomain.com>"
