{
  "name": "fitness-supplement-store-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "createdb": "tsx src/db/createDatabase.ts",
    "init": "tsx src/db/init.ts",
    "seed": "tsx src/db/seed.ts",
    "setup": "npm run createdb && npm run init && npm run seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.15.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
